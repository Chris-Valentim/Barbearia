# URL base da API. O prefixo EXPO_PUBLIC_ é obrigatório — sem ele o Expo não
# injeta a variável no bundle e ela chega como undefined no app.
#
# Atenção: "localhost" só funciona no emulador rodando na mesma máquina que a
# api. Em device físico, use o IP da máquina na rede local:
#   EXPO_PUBLIC_URL_BASE="http://192.168.0.10:3001"
EXPO_PUBLIC_URL_BASE="http://localhost:3001"
